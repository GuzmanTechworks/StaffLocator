generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  firstName   String   @default("") @db.VarChar(80)
  lastName    String   @default("") @db.VarChar(80)
  nickname    String   @default("") @db.VarChar(80)
  username    String   @unique @db.VarChar(80)
  password    String   @db.VarChar(255)
  phoneNumber String   @default("") @db.VarChar(20)
  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now())
  visits      Visit[]
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  visits    Visit[]
}

model Visit {
  id          Int       @id @default(autoincrement())
  userId      Int
  locationId  Int?
  destination String    @default("") @db.VarChar(200)
  purpose     String    @default("") @db.VarChar(255)
  timedOutAt  DateTime  @default(now())
  timedInAt   DateTime?
  groupId     String?   @db.VarChar(36)
  remarks     String    @default("") @db.VarChar(255)
  user        User      @relation(fields: [userId], references: [id])
  location    Location? @relation(fields: [locationId], references: [id])

  @@index([timedInAt])
  @@index([userId, timedInAt])
  @@index([groupId])
}
